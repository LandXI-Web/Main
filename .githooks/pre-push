#!/bin/sh
# 보내기 전 비밀값 검사(10-22) — 보내려는 커밋들의 더한 줄을 다시 본다(커밋 고리를 건너뛴 커밋도 잡게).
z=0000000000000000000000000000000000000000
while read lref lsha rref rsha; do
  [ "$lsha" = "$z" ] && continue
  if [ "$rsha" = "$z" ]; then base=$(git merge-base "$lsha" origin/plan1-foundation 2>/dev/null || git rev-list --max-parents=0 "$lsha" | tail -1); else base=$rsha; fi
  node "$(git rev-parse --show-toplevel)/tools/check/secrets.mjs" --range "$base..$lsha" || exit 1
done
exit 0
