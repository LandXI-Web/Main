# Land-XI vLLM 설정 — 복사해서 .env 로 쓴다:  Copy-Item .env.example .env
# launch-vllm.ps1 은 *_GPU_UTIL 을 실측 여유 VRAM 으로 계산해 이 값을 덮어쓴다(여기 값은 수동 compose 용 기본).

# ── 이미지 (버전 고정) ─────────────────────────────────────────────
# 기본: v0.30.0 (CUDA 13.0.2) → 드라이버 R580 이상.
VLLM_IMAGE=vllm/vllm-openai:v0.30.0@sha256:5f5e535216848d0c52159c8c13a0af04be5f6fe1a84e79914300610796f76d40
# 드라이버를 R575~R579 까지만 올린 경우(CUDA 12.9):
# VLLM_IMAGE=vllm/vllm-openai:v0.30.0-cu129@sha256:58fdb6bb123a81aa53f46fa4652ad8cc87e817bd1077c9832c6258ef12c1c688

# ── GPU (한 장만!) ──────────────────────────────────────────────────
# 1 = Windows nvidia-smi 의 GPU 1 (PCI 41:00.0). CUDA_DEVICE_ORDER=PCI_BUS_ID 로 번호가 Windows 와 같다 [실측].
# UUID 도 가능: GPU-5ee3b561-61c6-aa15-01e9-2193c49e6d1c (GPU1) / GPU-878af244-f546-6eab-7286-1278befa2963 (GPU0)
# 쉼표로 두 장을 넣지 말 것(전력 규칙: 동시 고부하 GPU ≤ 1).
VLLM_GPU=1

# ── 경로 (E: 드라이브) ──────────────────────────────────────────────
LANDXI_MODELS_DIR=E:/Land-XI 플랫폼/_env/models
LANDXI_VLLM_CACHE=E:/Land-XI 플랫폼/_env/models/vllm-cache

# ── 네트워크 ─────────────────────────────────────────────────────────
# 127.0.0.1 = 이 PC 안(게이트웨이 :8700)만. 다른 노드에서 붙어야 할 때만 0.0.0.0 + API 키.
VLLM_BIND=127.0.0.1
VLLM_PORT=8000
ROUTER_PORT=8001
# 비우면 인증 없음(로컬 바인드일 때만 허용). 0.0.0.0 으로 열면 반드시 설정.
VLLM_API_KEY=

# ── 두뇌: Gemma 4 12B QAT W4A16 ──────────────────────────────────────
# 0.36 × 49,140MiB ≈ 17.3GiB (가중치 ~10.3GB + KV/활성). Ollama 상주(~24GB) 와 공존하는 값.
GEMMA_GPU_UTIL=0.36
GEMMA_MAX_LEN=16384
GEMMA_MAX_SEQS=8
GEMMA_MAX_BATCHED=4096
GEMMA_MAX_IMAGES=4
# 이미지 1장당 토큰: 70/140/280/560/1120. 정사영상 크롭은 560 [추정], 세밀 판독은 1120(메모리↑)
GEMMA_IMAGE_TOKENS=560
# 추가 인자(예: --enforce-eager 로 CUDA graph 메모리 절약, --kv-cache-dtype fp8 [Ampere 동작 미검증])
GEMMA_EXTRA_ARGS=

# ── 라우터: HyperCLOVAX SEED 1.5B (profile router) ──────────────────
# 0.09 × 49,140MiB ≈ 4.3GiB (가중치 ~3.2GB)
ROUTER_GPU_UTIL=0.09
ROUTER_MAX_LEN=4096
ROUTER_MAX_SEQS=8
ROUTER_EXTRA_ARGS=--enforce-eager
