# Land-XI 게이트웨이·워커 환경 (F1-CONTRACT §1 · §3)
# setup.ps1 이 이 파일을 server/.env 로 복사한다(이미 있으면 건드리지 않음). 실운영 전 전부 교체.
LX_DATA_ROOT=E:/Land-XI 플랫폼/02. 데이터
LX_DEV=1
LX_API_PORT=8700
LX_MOCK_PORT=8701
LX_PUBLIC_BASE=http://localhost:8700
REDIS_URL=redis://localhost:6380/0
PG_ADMIN_PASSWORD=landxi-dev-admin
PG_APP_PASSWORD=landxi-dev-app
PG_ADMIN_DSN=postgresql://postgres:landxi-dev-admin@localhost:5433/landxi
PG_DSN=postgresql://landxi_app:landxi-dev-app@localhost:5433/landxi
# 워커 전용(BYPASSRLS · COPY detections) — 게이트웨이는 쓰지 않는다
PG_WORKER_PASSWORD=landxi-dev-worker
PG_WORKER_DSN=postgresql://landxi_worker:landxi-dev-worker@localhost:5433/landxi
# 개발 계정 7개(lx-admin lx-staff lx-sales / namwon-manager gj-manager kgz-agri-manager kgz-land-manager) 공통 비밀번호
DEV_PASSWORD=landxi-dev-2026
# 타일 서명(HMAC-SHA256) · 세션 토큰 해시 소금
SESSION_SECRET=change-me-landxi-dev-secret
# V-World — 비어 있거나 권한 미반영이면 프록시는 503 vworld_key_pending
VWORLD_KEY=
VWORLD_DOMAIN=
# 외부 도구
GDAL_BIN=C:/Users/User/anaconda3/envs/gcs/Library/bin
# 영상 표준(원칙 94 · 확인 대장 15차 영상-1) — ECW · JP2 를 읽는 GDAL(bin 폴더). 영상마다 그 형식을 읽을 수 있는 GDAL 을 고른다(GDAL_BIN 이 먼저).
# 비우면 ECW 는 받지 않는다(기관: 'TIF 로 저장해 올려 주세요' · LX: 'ECW 변환기가 이 서버에 없습니다'). 서버 자동 처리의 ECW 라이선스는 정식 오픈 전 확인.
LX_ECW_GDAL_BIN=C:/Program Files/QGIS 3.28.3/bin
NVIDIA_SMI=C:/Windows/System32/nvidia-smi.exe
# 워커
LX_NODE_ID=node-tr3995wx
LX_POOL=a6000
LX_VRAM_RESERVE_MIB=2048
APPROVALS_REQUIRED=1
